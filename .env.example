# =============================================================================
# 設定ファイル（このファイルを .env にコピーして編集する）
#   cp .env.example .env
# .env は .gitignore に入っているので、APIキーを書いてもコミットされません。
# =============================================================================

# NGC の API キー（https://ngc.nvidia.com → 右上のアカウント → Setup → Generate API Key）
NGC_KEY=

# TAO のコンテナ（タグは固定して再現性を保つ）
#   7.2.0-pyt   : ドライバー 595.45.04 以上が必要（CUDA 13.2）
#   6.26.3-pyt  : ドライバー 580 以上で動く（CUDA 13.0）— ドライバーを 595 にできない場合
TAO_IMAGE=nvcr.io/nvidia/tao/tao-toolkit:7.2.0-pyt

# 実験名（results/<EXPERIMENT>/ に結果が保存される）
EXPERIMENT=rtdetr_r50_v1

# 使う GPU（カンマ区切り）。3090 ×2 なら 0,1
GPU_IDS=0,1

# 訓練の基本設定（spec の値をコマンドラインで上書きする）
NUM_EPOCHS=72
BATCH_SIZE=4          # 1GPU あたり。3090(24GB) + ResNet50 + 640x640 なら 4〜8
INPUT_WIDTH=640
INPUT_HEIGHT=640

# 事前学習済みモデル（scripts/02_download_pretrained.sh で models/ に置いたもの）
# どちらか一方を指定する（両方指定すると、TAO はバックボーンの方を無視する）
#   PRETRAINED_MODEL    : 検出器全体（バックボーン + エンコーダー + デコーダー）の重み
#   PRETRAINED_BACKBONE : バックボーン（ResNet50）だけの重み
# 検出器全体の重みでバックボーンが読み込まれない場合（訓練後に警告が出る）は、
# scripts/fix_pretrained.sh でキー名を付け替えた _fixed.pth を PRETRAINED_MODEL に指定する。
# 例（TrafficCamNet Transformer Lite。TAO 6.26.3 ではこの変換が必要）:
#   ./scripts/fix_pretrained.sh models/trafficcamnet_transformer_lite_vtrainable_resnet50_v2.0/resnet50_trafficcamnet_rtdetr.pth
#   PRETRAINED_MODEL=/workspace/models/trafficcamnet_transformer_lite_vtrainable_resnet50_v2.0/resnet50_trafficcamnet_rtdetr_fixed.pth
PRETRAINED_MODEL=
PRETRAINED_BACKBONE=
